# URL del backend (en producción: https://tu-app.up.railway.app/api)
# En desarrollo se usa el proxy de Vite, así que no es necesario definirla
VITE_API_URL=

# Ejemplo producción:
# VITE_API_URL=https://tu-backend.up.railway.app/api
#
# En Railway (backend) configura también:
# FRONTEND_URL=https://tu-dominio-del-frontend.com
# o CORS_ALLOWED_ORIGINS=https://tu-dominio.com,https://www.tu-dominio.com

# Minutos sin actividad antes de cerrar sesión (por defecto: 480 = 8 horas)
# VITE_SESSION_INACTIVITY_MINUTES=480
